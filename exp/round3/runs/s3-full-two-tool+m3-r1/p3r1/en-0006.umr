s25w: 19-19

# document level annotation:
(s25s0 / sentence
    :temporal ((document-creation-time :before s25s)
               (s25s :before s25c)
               (s25c :overlap s25l)
               (s25c :overlap s25d)
               (s25c :before s25le)
               (s25le :overlap s25w))
    :modal ((root :modal author)
            (author :full-affirmative s25s)
            (s25p :full-affirmative s25c)
            (s25p :full-negative s25d)
            (s25p :full-affirmative s25l)
            (s25p :full-affirmative s25le)
            (s25p :full-affirmative s25w))
    :coref ((s21p :same-entity s25p)
            (s21r :subset-of s25r)))


