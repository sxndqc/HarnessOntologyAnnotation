s31v: 16-16
s31x1: 0-0
s31x2: 0-0

# document level annotation:
(s31s0 / sentence
    :temporal ((document-creation-time :overlap s31i1)
               (document-creation-time :overlap s31i2)
               (s31i2 :overlap s31pl))
    :modal ((root :modal author)
            (author :full-affirmative s31i1)
            (author :full-affirmative s31i2)
            (author :full-affirmative s31pl))
    :coref ((s30o :same-entity s31o)
            (s1k :same-entity s31k)
            (s1v :same-entity s31v)))


