s31o: 1-2
s31on: 0-0
s31p: 0-0
s31p2: 0-0
s31pl: 27-27
s31t: 0-0
s31t2: 0-0

# document level annotation:
(s31s0 / sentence
    :temporal ((document-creation-time :overlap s31b)
               (document-creation-time :overlap s31c)
               (document-creation-time :overlap s31pl))
    :modal ((root :modal author)
            (author :full-affirmative s31b)
            (author :full-affirmative s31c)
            (author :full-affirmative s31pl))
    :coref ((s30o :same-entity s31o)))


