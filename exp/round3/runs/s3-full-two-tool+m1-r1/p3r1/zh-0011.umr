s25j: 13-13
s25n: 26-26
s25p: 6-6
s25r: 5-5
s25s: 22-22
s25w: 23-23
s25x: 3-3

# document level annotation:
(s25s0 / sentence
    :temporal ((document-creation-time :overlap s25r)
               (document-creation-time :overlap s25i)
               (document-creation-time :overlap s25n))
    :modal ((root :modal author)
            (author :full-affirmative s25r)
            (s25x :full-affirmative s25i)
            (s25x :full-negative s25n))
    :coref ((s24p :same-entity s25p)))


