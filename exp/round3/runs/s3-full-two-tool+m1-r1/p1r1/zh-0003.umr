s31v: 16-16

# document level annotation:
(s31s0 / sentence
    :temporal ((document-creation-time :overlap s31b)
               (document-creation-time :overlap s31b2)
               (document-creation-time :overlap s31p))
    :modal ((root :modal author)
            (author :full-affirmative s31b)
            (author :full-affirmative s31b2)
            (author :full-affirmative s31p))
    :coref ((s30o :same-entity s31o)
            (s31s :subset-of s1t2)
            (s31s2 :subset-of s1t2)
            (s1k :same-entity s31k)
            (s1v :same-entity s31v)))


