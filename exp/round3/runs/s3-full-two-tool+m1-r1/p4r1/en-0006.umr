# document level annotation:
(s25s0 / sentence
    :temporal ((document-creation-time :before s25s)
               (s25c :overlap s25le)
               (s25le :overlap s25w))
    :modal ((root :modal author)
            (author :full-affirmative s25s)
            (s25l :full-affirmative s25c)
            (s25l :full-negative s25d)
            (s25l :full-affirmative s25le)
            (s25l :full-affirmative s25w))
    :coref ((s12l :same-entity s25l)
            (s4l :same-event s25ls)))


