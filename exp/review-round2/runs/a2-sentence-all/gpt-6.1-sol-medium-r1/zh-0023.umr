# document level annotation:
(s17s0 / sentence
    :temporal ((document-creation-time :before s17j)
               (s17j :overlap s17k)
               (s17k :after s17m)
               (s17m :after s17s)
               (document-creation-time :overlap s17z)
               (s17z :after s17s2)
               (s17s2 :after s17c)
               (s17c :overlap s17f)
               (s17f :overlap s17b)
               (s17f :overlap s17t2))
    :modal ((root :modal author)
            (author :full-affirmative s17j)
            (author :full-affirmative s17k)
            (author :full-affirmative s17z)
            (author :full-affirmative s17m)
            (author :full-affirmative s17s)
            (author :full-affirmative s17s2)
            (author :full-affirmative s17f)
            (author :full-affirmative s17b)
            (author :full-affirmative s17t2)
            (author :full-affirmative s17c))
    :coref ((s16t :same-entity s17t)))


