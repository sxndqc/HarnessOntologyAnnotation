s43pe: 13-13
s43u: 12-12
s43v: 0-0

# document level annotation:
(s43s0 / sentence
    :temporal ((s43p :overlap document-creation-time)
               (s43na :overlap s43p)
               (s43u :overlap document-creation-time))
    :modal ((root :modal author)
            (author :full-affirmative s43p)
            (author :full-affirmative s43na)
            (author :full-affirmative s43u))
    :coref ((s5p :same-entity s43m)
            (s16me :same-entity s43pe)))


